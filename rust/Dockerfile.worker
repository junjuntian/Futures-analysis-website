FROM rust:1.96.0-bookworm AS builder
ARG GIT_SHA=local
WORKDIR /app
COPY rust ./rust
WORKDIR /app/rust
RUN GIT_SHA="${GIT_SHA}" cargo build --release -p worker

FROM debian:13.2-slim
ARG GIT_SHA=local
LABEL org.opencontainers.image.revision="${GIT_SHA}"
WORKDIR /app
COPY --from=builder /app/rust/target/release/worker /app/worker
CMD ["/app/worker"]
