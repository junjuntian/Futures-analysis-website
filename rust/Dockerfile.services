## api 镜像的构建。原来 api 与 worker 共用这一份(同一个 workspace 编一次,
## 第二个 target 全程命中缓存)。worker 已随导入通道摘除,这里只剩 api。

FROM rust:1.96.0-bookworm AS chef
RUN cargo install cargo-chef --version 0.1.77 --locked
WORKDIR /app/rust

FROM chef AS planner
COPY rust .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
ARG GIT_SHA=local
COPY --from=planner /app/rust/recipe.json recipe.json
# Compile only the dependency graph first. This layer is keyed on recipe.json,
# so it stays cached across source-only changes and a one-line edit no longer
# recompiles every crate.
RUN cargo chef cook --release --jobs 2 --recipe-path recipe.json
COPY rust .
RUN GIT_SHA="${GIT_SHA}" cargo build --release --jobs 2 -p api

FROM debian:13.2-slim AS api
ARG GIT_SHA=local
LABEL org.opencontainers.image.revision="${GIT_SHA}"
WORKDIR /app
COPY --from=builder /app/rust/target/release/api /app/api
EXPOSE 8080
CMD ["/app/api"]

