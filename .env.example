APP_NAME=futures-analysis-platform
APP_VERSION=0.1.0
APP_ENV=development
API_BIND_ADDR=0.0.0.0:8080
WORKER_BIND_ADDR=0.0.0.0:8081
DATABASE_URL_FILE=/run/secrets/database-url
FUTURES_SECRETS_HOST_DIR=/etc/futures-platform/secrets
POSTGRES_DB=futures_platform
POSTGRES_USER=futures_app
POSTGRES_PASSWORD=futures_app_dev_password
RUST_LOG=info
PUBLIC_ORIGIN=http://localhost:8088
AUTH_COOKIE_SECURE=false
BOOTSTRAP_TOKEN_FILE=/run/secrets/bootstrap-token
MASTER_KEY_PATH=/run/secrets/master-key-v1
