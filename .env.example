APP_NAME=futures-analysis-platform
APP_VERSION=0.1.0
API_BIND_ADDR=0.0.0.0:8080
WORKER_BIND_ADDR=0.0.0.0:8081
DATABASE_URL=postgres://futures_app:futures_app_dev_password@postgres:5432/futures_platform
